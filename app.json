{
  "expo": {
    "name": "Savely: Save & Organize",
    "description": "Save and organize content from any platform into your personal digital library.",
    "slug": "savely",
    "owner": "omtunlabss-organization",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "savely",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.savelyapp.savely",
      "associatedDomains": [
        "applinks:savely.app"
      ],
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      },
      "infoPlist": {
        "CFBundleDisplayName": "Savely: Save & Organize",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.savelyapp.savely",
      "adaptiveIcon": {
        "backgroundColor": "#27262b",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "savely.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#27262b",
          "dark": {
            "backgroundColor": "#27262b"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Savely needs access to your photo library to let you choose images for your profile.",
          "cameraPermission": "Savely needs camera access if you choose to take a new photo for your profile."
        }
      ],
      [
        "expo-share-intent",
        {
          "iosAppGroupIdentifier": "group.com.savelyapp.savely",
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#333333",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Savely"
        }
      ],
      "./plugins/with-android-sharing-shortcuts.js",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "privacyPolicyUrl": "https://tunacodin.github.io/savely/privacy.html",
      "router": {},
      "eas": {
        "projectId": "8bf772d1-5789-43ce-a6c1-db7ec819cbcb"
      }
    }
  }
}
